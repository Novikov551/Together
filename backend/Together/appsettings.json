{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient.IWialonClient.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.IAxentaClient.LogicalHandler": "Warning",
      "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning",
      "Quartz": "Information"
    }
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient.IWialonClient.LogicalHandler": "Warning",
        "System.Net.Http.HttpClient.IAxentaClient.LogicalHandler": "Warning",
        "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning",
        "Quartz": "Information",
        "Stemy.ErrorHandling": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} | {Properties:j} | {SourceContext} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionalLogContext"
    ],
    "Properties": {
      "ApplicationName": "Together"
    }
  },
  "LiveKit": {
    "ApiKey": "YOUR_LIVEKIT_API_KEY",
    "ApiSecret": "YOUR_LIVEKIT_API_SECRET",
    "WebSocketUrl": "ws://localhost:7880"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS"
  },
  "AdminProfile": {
    "user_name": "YOUR_ADMIN_USERNAME",
    "password": "YOUR_ADMIN_PASSWORD"
  },
  "AllowedHosts": "*"
}